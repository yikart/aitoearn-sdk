    "confirm": "none",
    "inputSchema": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "title": "图片地址"
        },
        "alt": {
          "type": "string",
          "maxLength": 200,
          "title": "替代文本"
        }
      },
      "required": [
        "url",
        "alt"
      ]
    },
    "errors": [
      "AIT-AG-003"
    ],
    "backend": [
      "uploadAsset"
    ]
  },
  {
    "name": "publish_post",
    "description": "发布图文到指定渠道。写操作：默认 dryRun 返回将发生的变更，需用户确认后才真正执行。错误码: AIT-AG-001, AIT-AG-002, AIT-AG-004",
    "sideEffect": "write",
    "confirm": "required",
    "inputSchema": {
      "type": "object",
      "properties": {
        "channelId": {
          "type": "string",
          "title": "目标渠道"
        },
        "text": {
          "type": "string",
          "maxLength": 1000,
          "title": "正文"
        },
        "assetIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "title": "配图"
        },
        "visibility": {
          "type": "string",
          "title": "可见范围",
          "default": "public"
        },
        "dryRun": {
          "type": "boolean",
          "default": true,
          "deprecated": true
        }
      },
      "required": [
        "channelId",
        "text",
        "assetIds"
      ]
    },
    "errors": [
      "AIT-AG-001",
      "AIT-AG-002",
      "AIT-AG-004"
    ],
    "backend": [
      "publishChannelTask"
    ]
  },
  {
    "name": "delete_post",
    "description": "删除已发布内容。写操作：默认 dryRun 返回将发生的变更，需用户确认后才真正执行。错误码: AIT-AG-001, AIT-AG-005",
    "sideEffect": "write",
    "confirm": "required",
    "inputSchema": {
      "type": "object",
      "properties": {
        "externalId": {
          "type": "string",
          "title": "外部平台内容 ID"
        },
        "dryRun": {
          "type": "boolean",
          "default": true,
          "deprecated": true
        }
      },
      "required": [
        "externalId"
      ]
    },
    "errors": [
      "AIT-AG-001",
      "AIT-AG-005"
    ],
    "backend": [
      "deleteChannelPost"
    ]
  }
]
