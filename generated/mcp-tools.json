        "channelId",
        "text"
      ]
    },
    "errors": [],
    "backend": [
      "createDraft"
    ]
  },
  {
    "name": "upload_asset",
    "description": "上传图片素材。产生草稿，不改变线上状态。错误码: AIT-AG-003",
